#!/sbin/sh
# OpenSpoof update-binary — minimal installer for Magisk / KernelSU / APatch.
# Args from recovery/manager: <version> <out_fd> <zipfile>
# META-INF must exist for Magisk < 29 (updater-script must contain #MAGISK).

OUTFD="$2"
ZIPFILE="$3"
export OUTFD ZIPFILE

ui_print() {
  echo "ui_print $1" > "/proc/self/fd/$OUTFD" 2>/dev/null || echo "ui_print $1"
  echo "ui_print" > "/proc/self/fd/$OUTFD" 2>/dev/null || echo "ui_print"
}

MODPATH="/data/adb/modules_update/openspoof"
export MODPATH
rm -rf "$MODPATH"
mkdir -p "$MODPATH" || { ui_print "! cannot create $MODPATH"; exit 1; }

ui_print "- Extracting OpenSpoof..."
unzip -o "$ZIPFILE" -x 'META-INF/*' -d "$MODPATH" >&2 \
  || { ui_print "! unzip failed"; exit 1; }

chmod 0755 "$MODPATH/customize.sh"
ui_print "- Running installer..."
sh "$MODPATH/customize.sh" || { ui_print "! customize.sh failed"; exit 1; }
exit 0
